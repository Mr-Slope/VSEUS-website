# Vancouver Economic Review archive (/economicreview) only.
#
# The rest of the site needs no configuration and builds without this file.
# Leave these unset and the site still builds and deploys: only the Review
# archive renders its "not configured" state.
#
# Copy to .env.local for local development. In CI these are supplied as GitHub
# Actions repository variables, see README.
#
# NEXT_PUBLIC_ is required: without that prefix Next will not expose the value
# to the browser, and this section reads the archive client-side.
#
# The anon key is a publishable credential, safe in client code, with row level
# security as the actual boundary. Never put the service role key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
