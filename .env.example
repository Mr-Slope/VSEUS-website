# Copy to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (use the POOLED connection string).
# Create a database at https://neon.tech and copy it here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js session secret. Generate with: openssl rand -base64 33
AUTH_SECRET="replace-me"

# Secret used to derive the HMAC lookup index for membership codes.
# Generate a separate value with: openssl rand -base64 33
CODE_HMAC_SECRET="replace-me-too"
